# ============================================================
# DevJobs 2.0 — Variáveis de Ambiente
# ============================================================
#
# INSTRUÇÕES:
# 1. Copie este arquivo para .env.local
# 2. Preencha os valores reais das variáveis
# 3. NUNCA commite o .env.local ou qualquer arquivo com valores reais
# 4. Variáveis com NEXT_PUBLIC_ são expostas ao navegador — NÃO colocar secrets
# 5. Variáveis marcadas como [FUTURE] serão necessárias em etapas posteriores
#
# ============================================================

# ----------------------
# Aplicação
# ----------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=DevJobs 2.0

# Ambiente: development | staging | production
NODE_ENV=development

# ----------------------
# Supabase
# URL e chave anônima são públicas (usadas no frontend)
# ----------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service Role Key — SOMENTE server-side, NUNCA expor ao browser
# NUNCA colocar em variáveis NEXT_PUBLIC_*
# NUNCA incluir em componentes React ou código client-side
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ----------------------
# Stripe [FUTURE — ETAPA: Billing]
# NUNCA expor a secret key ao browser
# ----------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ----------------------
# IA / Provider Adapter [FUTURE — ETAPA: AI]
# O provider será configurado via abstração — não depende de fornecedor específico
# ----------------------
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# ----------------------
# E-mail [FUTURE — ETAPA: Messaging]
# O provider definitivo será definido posteriormente
# ----------------------
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=

# ----------------------
# Observabilidade [FUTURE — ETAPA: Analytics/Infra]
# ----------------------
# Sentry, Datadog, ou equivalente
OBSERVABILITY_DSN=
LOG_LEVEL=info

# ----------------------
# Storage [FUTURE]
# Supabase Storage — configurado via NEXT_PUBLIC_SUPABASE_URL
# Buckets definidos nas etapas de implementação de cada módulo
# ----------------------
# SUPABASE_STORAGE_BUCKET_RESUMES=
# SUPABASE_STORAGE_BUCKET_AVATARS=
